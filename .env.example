# === FACEIT ===
# Sacalo en https://developers.faceit.com (crea una app y genera una API key)
FACEIT_API_KEY=tu_api_key_aqui

# Tu nickname tal cual aparece en Faceit
FACEIT_NICKNAME=tu_nickname

# === STEAM ===
# Cuenta secundaria recomendada (la cuenta hace login con steam-user)
STEAM_USERNAME=tu_usuario_steam
STEAM_PASSWORD=tu_password_steam

# SteamID64 de la cuenta de la que quieres leer el ELO Premier
# Sacalo en https://steamid.io pegando la URL de tu perfil
STEAM_ID64=76561198000000000

# === Otros ===
TZ=Europe/Madrid